---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoadingGlyph from '../components/LoadingGlyph.astro';

const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${path}`;
---

<BaseLayout title="Page not found — OpenTî">
  <div class="page">
    <LoadingGlyph size={96} loop={false} label="OpenTî" />
    <h1>Page not found</h1>
    <p>
      The page you're looking for doesn't exist or has moved.
    </p>
    <a class="home-link" href={withBase('/')}>Back to the OpenTî home page →</a>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 32rem;
    margin-inline: auto;
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1rem;
    padding: clamp(2rem, 6vw, 5rem) 1.5rem;
  }

  .page p {
    color: color-mix(in srgb, var(--color-ink) 65%, transparent);
    line-height: 1.6;
  }

  .home-link {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-accent);
  }
</style>
