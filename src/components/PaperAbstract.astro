---
// The paper's abstract, rendered once before Section 1 on the full-paper pages (see
// [slug].astro, which shows this only on the first section — currently the introduction).
// Text lives in paper-meta.ts alongside title/authors, not as mdx content, since it's fixed
// paper metadata rather than section prose.
import { paperAbstract } from '../lib/paper-meta';
---

<section class="paper-abstract" aria-label="Abstract">
  <p class="paper-abstract__label">Abstract</p>
  <p class="paper-abstract__body">
    {paperAbstract}
  </p>
</section>

<style>
  .paper-abstract {
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 2px solid var(--color-hairline);
  }

  .paper-abstract__label {
    margin: 0 0 0.75rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .paper-abstract__body {
    margin: 0;
    font-style: italic;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-ink) 85%, transparent);
  }

  .paper-abstract__body a {
    font-style: normal;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-hairline);
  }

  .paper-abstract__body a:hover,
  .paper-abstract__body a:focus-visible {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }
</style>
